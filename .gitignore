# ac3ds-re: 既定ですべて無視し、許可した場所だけを追跡する。
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.githooks/
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/skills/
!/meta/
!/findings/
!/topics/
!/symbols/
!/archive/
!/docs/
!/tools/
!/.task/

# 許可した場所の中でも禁止（ROM・IDB・ダンプ・アーカイブなど）
*.cia
*.3ds
*.cci
*.cxi
*.app
*.bin
*.elf
*.3gx
*.i64
*.idb
*.id0
*.id1
*.id2
*.nam
*.til
*.gpr
*.rep
*.sav
*.dmp
*.zip
*.7z
__pycache__/
*.pyc
.pytest_cache/
